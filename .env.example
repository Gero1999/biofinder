# Copy to .env locally. Never commit .env or actual secret values.
# Live mode requires an OpenAI model supporting Chat Completions JSON responses.
OPENAI_API_KEY=""
BIOFINDER_MODEL=""
# Needed for live public web discovery; direct opens do not use this key.
BRAVE_SEARCH_API_KEY=""
# Explicit comma-separated public source hosts. Include redirect hosts if needed.
# These do not bypass the machine's network policy or DNS checks.
BIOFINDER_ALLOWED_HOSTS="www.ncbi.nlm.nih.gov,www.ebi.ac.uk,europepmc.org"
# Approved non-sensitive query terms only; no private passages or subject IDs.
BIOFINDER_PUBLIC_TERMS=""
BIOFINDER_REQUEST_LIMIT=30
BIOFINDER_MODEL_CALL_LIMIT=8
